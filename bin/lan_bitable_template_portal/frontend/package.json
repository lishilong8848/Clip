{
  "private": true,
  "name": "clipflow-lan-portal-frontend",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/prune-dist-assets.mjs",
    "check:navigation": "node scripts/check-navigation-back.mjs",
    "check:drill": "node scripts/check-drill-management.mjs",
    "check:reliability": "node scripts/check-request-reliability.mjs",
    "check:repair-submission": "node scripts/check-repair-submission.mjs",
    "check:cabinet-reliability": "node scripts/check-cabinet-reliability.mjs",
    "check:plan-convergence": "node --experimental-strip-types scripts/check-plan-convergence.ts",
    "smoke": "python ../../tools/frontend_runtime_smoke.py",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/vue": "3.0.299",
    "@tanstack/vue-virtual": "^3.13.12",
    "ai": "6.0.299",
    "dompurify": "3.4.16",
    "lucide-vue-next": "^0.468.0",
    "marked": "18.0.14",
    "vue": "^3.5.16"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "playwright": "^1.60.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vue-tsc": "^2.2.10"
  }
}
